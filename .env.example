# Required server-only Recall credentials. Never expose these to the browser.
RECALL_REGION=us-west-2
# Set true to run the labeled fixture demo without Recall credentials or live API calls.
MOCK_MODE=false
RECALL_API_KEY=
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Actual reserved public ngrok domain; do not use the placeholder.
PUBLIC_API_BASE_URL=https://your-reserved-domain.ngrok.app
# Set after Calendar V2 setup returns its regional callback URI.
RECALL_CALENDAR_REGIONAL_CALLBACK_URI=
# Required only when the user manually clicks Analyze transcript.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_CONCURRENCY=1
GROQ_MAX_INPUT_CHARACTERS=18000
PORT=3000

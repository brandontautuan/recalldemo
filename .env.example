# Required server-only Recall credentials. Never expose these to the browser.
RECALL_REGION=us-west-2
# Set true to run the labeled fixture demo without Recall credentials or live API calls.
MOCK_MODE=false
RECALL_API_KEY=
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Actual reserved public ngrok domain; do not use the placeholder.
PUBLIC_API_BASE_URL=https://your-reserved-domain.ngrok.app
# Set after Calendar V2 setup returns its regional callback URI.
RECALL_CALENDAR_REGIONAL_CALLBACK_URI=
# Required only when the user manually clicks Analyze transcript.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_CONCURRENCY=1
GROQ_MAX_INPUT_CHARACTERS=18000
# Local deterministic project-context storage and reviewed seed manifest.
DATABASE_PATH=data/project-context.sqlite
PROJECT_CONTEXT_SEED_PATH=seeds/project-context.example.json
PROJECT_CONTEXT_MAX_CHARACTERS=12000
# Colon-separated on macOS/Linux. Only repository paths inside these server-side roots may be configured.
PROJECT_REPOSITORY_ROOTS=
# Required when repository roots are enabled; enter this server-side value in the local dashboard when administering scans.
PROJECT_CONTEXT_ADMIN_TOKEN=
PROJECT_SCAN_MAX_FILES=20
PROJECT_SCAN_MAX_FILE_BYTES=100000
PROJECT_SCAN_MAX_FILE_CHARACTERS=6000
PORT=3000
HOST=127.0.0.1
